# Metron Docker Environment Configuration
# Copy this file to .env and customize for your environment

#############################################################################
# GENERAL SETTINGS
#############################################################################

# Environment (development, staging, production)
ENVIRONMENT=development

# Timezone
TZ=America/New_York

#############################################################################
# KAFKA CONFIGURATION
#############################################################################

# Kafka heap size
KAFKA_HEAP_OPTS=-Xmx2g -Xms2g

# Kafka retention (hours)
KAFKA_LOG_RETENTION_HOURS=168

# Kafka segment size (bytes)
KAFKA_LOG_SEGMENT_BYTES=1073741824

#############################################################################
# ELASTICSEARCH CONFIGURATION
#############################################################################

# Elasticsearch heap size
ES_JAVA_OPTS=-Xms4g -Xmx4g

# Elasticsearch cluster name
ES_CLUSTER_NAME=metron-cluster

# Elasticsearch node name
ES_NODE_NAME=metron-node-1

#############################################################################
# CASSANDRA CONFIGURATION
#############################################################################

# Cassandra heap size
MAX_HEAP_SIZE=2G
HEAP_NEWSIZE=400M

# Cassandra cluster name
CASSANDRA_CLUSTER_NAME=metron-cluster

# Cassandra datacenter
CASSANDRA_DC=dc1

#############################################################################
# METRON REST API
#############################################################################

# Port
METRON_REST_PORT=8080

# Spring profile
SPRING_PROFILES_ACTIVE=docker

# JVM options
METRON_JAVA_OPTS=-Xmx2g -Xms2g

#############################################################################
# NEO4J CONFIGURATION
#############################################################################

# Neo4j authentication
NEO4J_AUTH=neo4j/metron123

# Neo4j heap size
NEO4J_dbms_memory_heap_initial__size=2G
NEO4J_dbms_memory_heap_max__size=4G

#############################################################################
# SUPERSET CONFIGURATION
#############################################################################

# Secret key (change in production!)
SUPERSET_SECRET_KEY=metron-superset-secret-key-change-in-production

# Database credentials
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=superset123
SUPERSET_DB_NAME=superset

# Admin credentials
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin

# Redis
SUPERSET_REDIS_HOST=superset-redis
SUPERSET_REDIS_PORT=6379

#############################################################################
# AIRFLOW CONFIGURATION
#############################################################################

# Fernet key for encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=metron-fernet-key-change-in-production-base64encoded

# Webserver secret key
AIRFLOW_WEBSERVER_SECRET_KEY=metron-secret-key

# Database credentials
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow123
AIRFLOW_DB_NAME=airflow

# Admin credentials
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin

#############################################################################
# MLFLOW CONFIGURATION
#############################################################################

# Database credentials
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow123
MLFLOW_DB_NAME=mlflow

# Artifact storage
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

#############################################################################
# GRAFANA CONFIGURATION
#############################################################################

# Admin password
GRAFANA_ADMIN_PASSWORD=admin

# Plugins to install
GRAFANA_INSTALL_PLUGINS=grafana-piechart-panel

#############################################################################
# PROMETHEUS CONFIGURATION
#############################################################################

# Retention period
PROMETHEUS_RETENTION=30d

# Storage path
PROMETHEUS_STORAGE_PATH=/prometheus

#############################################################################
# FLINK CONFIGURATION
#############################################################################

# Job Manager heap size
FLINK_JM_HEAP=2048m

# Task Manager heap size
FLINK_TM_HEAP=4096m

# Task slots per TaskManager
FLINK_TASK_SLOTS=4

# Checkpoint interval (ms)
FLINK_CHECKPOINT_INTERVAL=60000

#############################################################################
# EXTERNAL SERVICES (Optional)
#############################################################################

# External Kafka (comment out to use internal)
# KAFKA_BOOTSTRAP_SERVERS=external-kafka:9092

# External Elasticsearch (comment out to use internal)
# ELASTICSEARCH_URL=http://external-es:9200

# External Cassandra (comment out to use internal)
# CASSANDRA_CONTACT_POINTS=external-cassandra

#############################################################################
# SECURITY SETTINGS
#############################################################################

# Enable TLS (true/false)
ENABLE_TLS=false

# Certificate paths (if TLS enabled)
TLS_CERT_PATH=/certs/cert.pem
TLS_KEY_PATH=/certs/key.pem

# LDAP/AD integration (optional)
# LDAP_URL=ldap://ldap.example.com
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=password

#############################################################################
# MONITORING & LOGGING
#############################################################################

# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Enable metrics export
ENABLE_METRICS=true

# Metrics export interval (seconds)
METRICS_INTERVAL=60

#############################################################################
# DEVELOPMENT SETTINGS
#############################################################################

# Enable debug mode
DEBUG=false

# Enable hot reload
HOT_RELOAD=false

# Mock external services
MOCK_SERVICES=false

#############################################################################
# BACKUP SETTINGS
#############################################################################

# Backup directory
BACKUP_DIR=/backups

# Backup retention (days)
BACKUP_RETENTION=30

# Backup schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"

#############################################################################
# RESOURCE LIMITS
#############################################################################

# Maximum memory per service (examples)
KAFKA_MEMORY_LIMIT=4g
ELASTICSEARCH_MEMORY_LIMIT=8g
CASSANDRA_MEMORY_LIMIT=4g
FLINK_JM_MEMORY_LIMIT=2g
FLINK_TM_MEMORY_LIMIT=4g
